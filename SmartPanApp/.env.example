# Copy to .env (gitignored). Expo exposes EXPO_PUBLIC_* variables to the app.

# WebSocket URL of host/ble_ws_bridge.py or host/mock_telemetry.py.
# On a physical phone use the host computer's LAN address, not localhost.
EXPO_PUBLIC_TELEMETRY_URL=ws://localhost:8765

# USDA FoodData Central API key (free: https://fdc.nal.usda.gov/api-key-signup).
# Leave unset to use DEMO_KEY, which allows 30 requests an hour and 50 a day.
EXPO_PUBLIC_USDA_API_KEY=
